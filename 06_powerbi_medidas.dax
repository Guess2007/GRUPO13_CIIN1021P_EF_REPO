-- PASO 6 - Medidas DAX para Power BI

Total Atenciones =
SUM(FactAtenciones[Atenciones])

Total Atendidos =
SUM(FactAtenciones[Atendidos])

Cantidad Establecimientos =
DISTINCTCOUNT(DimEstablecimiento[CodigoUnico])

Promedio Atenciones por Establecimiento =
DIVIDE([Total Atenciones], [Cantidad Establecimientos], 0)

Promedio Atenciones por Atendido =
DIVIDE([Total Atenciones], [Total Atendidos], 0)

Porcentaje Atenciones SIS =
DIVIDE(
    CALCULATE([Total Atenciones], DimPaciente[TipoSeguro] = "S.I.S"),
    [Total Atenciones],
    0
)
